ssession for access tokens] section for more information.`\n\nNot sure it is ideal either, but hopefully a bit more easier to consume\n","created_at":"2026-09-15T17:53:50Z","updated_at":"2026-09-15T17:53:50Z","html_url":"https://github.com/quarkusio/quarkus/pull/56598#discussion_r4018612763","pull_request_url":"https://api.github.com/repos/quarkusio/quarkus/pulls/56598","_links":{"self":{"href":"https://api.github.com/repos/quarkusio/quarkus/pulls/comments/4018612763"},"html":{"href":"https://github.com/quarkusio/quarkus/pull/56598#discussion_r4018612763"},"pull_request":{"href":"https://api.github.com/repos/quarkusio/quarkus/pulls/56598"}},"reactions":{"url":"https://api.github.com/repos/quarkusio/quarkus/pulls/comments/4018612763/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":983,"original_line":983,"side":"RIGHT","author_association":"MEMBER","original_position":27,"position":27,"subject_type":"line"},{"url":"https://api.github.com/repos/quarkusio/quarkus/pulls/comments/4018658503","pull_request_review_id":5213873169,"id":4018658503,"node_id":"PRRC_kwDOCFbutM7vh9zH","diff_hunk":"@@ -135,6 +136,44 @@ private void setDPopProof(RoutingContext context, OidcTenantConfig oidcTenantCon\n                 throw new AuthenticationFailedException(invalidDPoPProofMap(token));\n             }\n \n+            Object proofIatObj = proofJwtClaims.getValue(Claims.iat.name());\n+            if (proofIatObj == null) {\n+                LOG.debug(\"DPoP proof iat claim is missing\");\n+                throw new AuthenticationFailedException(invalidDPoPProofMap(token));\n+            }\n+            if (!(proofIatObj instanceof Number proofIatNumber)) {\n+                LOG.debug(\"DPoP proof iat claim is malformed\");\n+                throw new AuthenticationFailedException(invalidDPoPProofMap(token));\n+            }\n+            long proofIat = proof